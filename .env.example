# Copie este arquivo para ".env" e preencha com sua chave real.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# Chave de API da Groq -- gratuita, sem cartão de crédito.
# Crie a sua em https://console.groq.com/keys (veja o passo a passo no README).
GROQ_API_KEY=gsk_...

# Modelo usado pelo agente. Veja justificativa no README.
# Padrão: openai/gpt-oss-120b (bom equilíbrio raciocínio/tool-calling, gratuito na Groq).
# Alternativa mais rápida/leve: openai/gpt-oss-20b.
EMPORIO_MODEL=openai/gpt-oss-120b

# Máximo de tokens gerados por resposta do modelo.
EMPORIO_MAX_TOKENS=1024

# --- Banco de dados (MySQL) ---
# Esses valores já batem com o docker-compose.yml do projeto.
# Suba o banco com `docker compose up -d` antes de rodar o agente.
# Se você já tiver um MySQL próprio, só aponte as variáveis pra ele.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=emporio
MYSQL_PASSWORD=emporio_dev_only
MYSQL_DATABASE=emporio_musica

# Copie este arquivo para ".env" e preencha com sua chave real.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# Chave de API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado pelo agente. Veja justificativa no README.
# Padrão: modelo Sonnet mais recente (bom equilíbrio custo/qualidade para tool-use).
# Alternativa mais barata/rápida: um modelo Haiku.
EMPORIO_MODEL=claude-sonnet-5

# Máximo de tokens gerados por resposta do modelo.
EMPORIO_MAX_TOKENS=1024
